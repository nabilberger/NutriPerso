{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutri-perso-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-02-28",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "nutri.brainboost3d.com/api/*",
      "zone_name": "brainboost3d.com"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEAL_PHOTOS",
      "bucket_name": "nutriperso-meal-photos"
    }
  ],
  "triggers": {
    "crons": [
      "15 * * * *"
    ]
  }
}
